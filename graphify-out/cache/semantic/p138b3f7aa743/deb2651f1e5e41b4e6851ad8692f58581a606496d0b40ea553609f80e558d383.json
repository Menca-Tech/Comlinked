      "author": null,
      "contributor": null,
      "rationale": "The top bar follows the Seat; Community Manager and Chamber Contact Seats show a labelled bar with no member's initials. SEAT_BARS in product-bars.tsx."
    },
    {
      "id": "_scratch_pilot_preview_issues_03_walk_the_preview_and_hide_later_items_open_stop",
      "label": "openStop prepared states (STOP_STATES)",
