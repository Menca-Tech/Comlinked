    {
      "id": "_claude_skills_coding_standards_skill_server_action_authz",
      "label": "Server Actions are public POST endpoints: re-auth, ownership authz, zod-validate",
      "file_type": "rationale",
      "source_file": ".claude/skills/coding-standards/SKILL.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Page/layout/middleware gating is optimistic only; in-action checks prevent IDOR."
    },
    {
      "id": "_claude_skills_coding_standards_skill_strict_nonce_csp",
      "label": "Strict nonce + strict-dynamic CSP",
      "file_type": "rationale",
      "source_file": ".claude/skills/coding-standards/SKILL.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The nonce CSP forces dynamic rendering and @supabase/ssr cookies are not HttpOnly, so strict script-src is the primary defense against session-token theft."
    },
    {
      "id": "_claude_skills_coding_standards_skill_rls_every_table",
      "label": "RLS on every exposed table + cross-tenant denial test",
      "file_type": "rationale",
      "source_file": ".claude/skills/coding-standards/SKILL.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Drizzle/postgres.js connects as table owner and bypasses RLS, so tenancy must be scoped in app WHERE clauses or per-txn role."
    },
