    {
      "id": "docs_specs_2026_07_31_coding_standards_data_access_layer",
      "label": "Server-only Data Access Layer / service seam",
      "file_type": "concept",
      "source_file": "docs/specs/2026-07-31-coding-standards.md",
      "source_location": "L22",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Only the DAL reads env; reads are Server Components, writes are thin Server Functions that delegate to the DAL and return DTOs, not raw rows."
    },
    {
      "id": "docs_specs_2026_07_31_coding_standards_server_actions_public_endpoints",
      "label": "Server Actions are public POST endpoints",
      "file_type": "rationale",
      "source_file": "docs/specs/2026-07-31-coding-standards.md",
      "source_location": "L35",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Each must re-authenticate, authorize the specific resource (IDOR) and zod-validate every argument; page, layout and middleware gating are optimistic only. Roles come from app_metadata.role only."
    },
