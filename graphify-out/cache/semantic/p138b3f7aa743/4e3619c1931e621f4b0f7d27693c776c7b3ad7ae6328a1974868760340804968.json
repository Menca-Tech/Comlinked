      "author": null,
      "contributor": null,
      "rationale": "The chamber's own screen built from ComDash's parts: five figures, one status per member, filters, and a side column of wins and Monthly Top Companies. It shows totals and status only so the Chamber Leader can promise members their dealings stay private."
    },
    {
      "id": "_scratch_pilot_preview_issues_05_eccp_activity_view_member_status",
      "label": "One status per member",
      "file_type": "rationale",
      "source_file": ".scratch/pilot-preview/issues/05-eccp-activity-view.md",
      "source_location": "L85",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Order: Not yet claimed; Needs an intro (claimed, no Lead); Active (claimed and acted in the last 7 days); Quiet. Never depends on dealings with Kalayaan; introductions by the Community Manager or staff are recorded in one place."
    },
    {
      "id": "_scratch_pilot_preview_issues_05_eccp_activity_view_day_14_figures",
      "label": "Day 14 figures 40 / 20 / 4 / 3 / 2",
      "file_type": "rationale",
      "source_file": ".scratch/pilot-preview/issues/05-eccp-activity-view.md",
