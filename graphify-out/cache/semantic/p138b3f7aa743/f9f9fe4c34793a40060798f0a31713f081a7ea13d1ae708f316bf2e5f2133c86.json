    {
      "id": "_claude_skills_posthog_skill_serverless_flush",
      "label": "Serverless flush: fresh client per request, captureImmediate, await shutdown()",
      "file_type": "rationale",
      "source_file": ".claude/skills/posthog/SKILL.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "A serverless function must not exit before the event/flag call completes; a cached singleton is unsafe with per-request shutdown."
    },
    {
      "id": "_claude_skills_posthog_skill_consent_gating",
      "label": "Consent-gated capture (identified_only, respect_dnt, optIn)",
      "file_type": "rationale",
      "source_file": ".claude/skills/posthog/SKILL.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "GDPR: with consent required and no banner, zero events fire by design."
    },
    {
      "id": "_claude_skills_posthog_skill_defaults_spa_pageviews",
