    {
      "id": "_claude_skills_posthog_skill_opt_in_inert",
      "label": "PostHog opt-in / inert by default (NEXT_PUBLIC_POSTHOG_KEY, isAnalyticsConfigured)",
      "file_type": "rationale",
      "source_file": ".claude/skills/posthog/SKILL.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Token is publishable so it lives in src/env.ts, never src/env.server.ts."
    },
    {
      "id": "_claude_skills_posthog_skill_relay_reverse_proxy",
      "label": "/relay reverse proxy (one constant, three places in sync)",
      "file_type": "rationale",
      "source_file": ".claude/skills/posthog/SKILL.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "If the CSP middleware intercepts /relay it silently breaks ingestion while assets still load."
    },
    {
      "id": "_claude_skills_posthog_skill_session_replay_worker_src",
      "label": "Session Replay CSP delta: worker-src 'self' blob:",
      "file_type": "rationale",
      "source_file": ".claude/skills/posthog/SKILL.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The replay recorder runs in a blob: Web Worker, which strict-dynamic does not cover; add it only when replay is on."
    },
    {
      "id": "_claude_skills_posthog_skill_server_flags_evaluateflags",
      "label": "Server feature flags via evaluateFlags()",
