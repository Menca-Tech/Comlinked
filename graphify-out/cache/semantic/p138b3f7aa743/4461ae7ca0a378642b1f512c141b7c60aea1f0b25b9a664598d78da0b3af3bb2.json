      "label": "One claim day per Company",
      "file_type": "rationale",
      "source_file": ".scratch/pilot-preview/issues/01-claim-day-and-network-of-100.md",
      "source_location": "L77",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Replaces two disagreeing sources (AGENT_STATUS 'unclaimed' and teamRec's claimDay formula) with one claim day held with each Company's data and read through one function (hasClaimed / claimDayOf)."
    },
    {
      "id": "_scratch_pilot_preview_issues_01_claim_day_and_network_of_100_never_acts_rule",
      "label": "Unclaimed Company never acts",
      "file_type": "rationale",
      "source_file": ".scratch/pilot-preview/issues/01-claim-day-and-network-of-100.md",
      "source_location": "L78",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "A Company that has not claimed sends no signal, message or Connection Request, accepts none, replies to none, posts no Ask, holds no points and is not in rank() or Monthly Top Companies; tested across 30 mornings."
    },
    {
      "id": "_scratch_pilot_preview_issues_01_claim_day_and_network_of_100_network_of_100",
      "label": "Network of 100 Companies under ECCP",
      "file_type": "concept",
      "source_file": ".scratch/pilot-preview/issues/01-claim-day-and-network-of-100.md",
      "source_location": "L79",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Kalayaan Foods, the 39 original Companies and 60 European-style members brought from the mockup's network.js, each with an invented website on a reserved example domain."
    },
    {
      "id": "_scratch_pilot_preview_issues_01_claim_day_and_network_of_100_chamber_setting",
      "label": "Chamber setting (chamber.ts)",
      "file_type": "rationale",
      "source_file": ".scratch/pilot-preview/issues/01-claim-day-and-network-of-100.md",
      "source_location": "L71",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Short name ECCP, full name European Chamber of Commerce of the Philippines, sender name ECCP Membership and presenter first name Richard; renaming the chamber changes one file; ECCP appears as text only, never a logo."
    },
    {
      "id": "_scratch_pilot_preview_issues_01_claim_day_and_network_of_100_claim_schedule",
      "label": "Claim schedule (40 of 100 claimed on Day 14)",
      "file_type": "rationale",
      "source_file": ".scratch/pilot-preview/issues/01-claim-day-and-network-of-100.md",
