    {
      "id": "_scratch_comdash_redesign_issues_01_session_1_shell_overview_next_action_interest_level_rule",
      "label": "Interest Level rule (Hot / Warm / New)",
      "file_type": "rationale",
      "source_file": ".scratch/comdash-redesign/issues/01-session-1-shell-overview-next-action.md",
      "source_location": "L65",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Over the last 14 simulated days: Hot if the Company messaged or showed interest on 3+ separate days; Warm if 2 separate days or it saved the profile; New after one signal. Same-day repeats count once."
    },
    {
      "id": "_scratch_comdash_redesign_issues_01_session_1_shell_overview_next_action_next_action_order",
      "label": "Next action 8-step order",
