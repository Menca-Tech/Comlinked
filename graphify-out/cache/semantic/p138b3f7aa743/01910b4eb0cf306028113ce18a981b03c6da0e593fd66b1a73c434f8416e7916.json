      "id": "docs_adr_0007_analytics_posthog_opt_in_inert",
      "label": "Opt-in, inert by default (isAnalyticsConfigured, NEXT_PUBLIC_POSTHOG_KEY)",
      "file_type": "rationale",
      "source_file": "docs/adr/0007-analytics-posthog.md",
      "source_location": "L23",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Analytics must not fire or add network, cost or privacy exposure until a project turns it on, preserving the runs-with-nothing-configured default."
    },
    {
