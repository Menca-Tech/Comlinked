{
  "nodes": [
    {
      "id": "docs_presentations_comlinked_stack_overview_application_stack_overview",
      "label": "Application Stack Overview",
      "file_type": "document",
      "source_file": "docs/presentations/comlinked-stack-overview.pdf",
      "source_location": "p.1",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Comlinked is built on a production-grade, fully typed TypeScript template with security, testing and CI/CD from the first commit. Faster to build (auth, dashboard, team management, settings and a reference feature ready; one proven pattern), built to scale (server-first rendering, typed data layer, multi-tenant isolation), easy to maintain (strict typing, automated formatting, enforced commit standards, ADRs). No proprietary lock-in in application code."
    },
    {
      "id": "docs_presentations_comlinked_stack_overview_nextjs_react_typescript",
      "label": "Next.js 15 / React 19 / TypeScript (strict)",
      "file_type": "concept",
      "source_file": "docs/presentations/comlinked-stack-overview.pdf",
      "source_location": "p.1",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "App Router with React Server Components: data stays on the server, less code ships to the browser."
    },
    {
      "id": "docs_presentations_comlinked_stack_overview_tailwind_shadcn_radix",
      "label": "Tailwind CSS v4 / shadcn/ui / Radix",
      "file_type": "concept",
      "source_file": "docs/presentations/comlinked-stack-overview.pdf",
      "source_location": "p.1",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Accessible, themeable (light/dark) components the team owns and can customize freely."
    },
    {
      "id": "docs_presentations_comlinked_stack_overview_react_hook_form_zod",
      "label": "React Hook Form + Zod validation",
      "file_type": "concept",
