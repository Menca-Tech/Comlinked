    {
      "id": "docs_presentations_comlinked_stack_overview_defense_in_depth",
      "label": "Defense in depth (secured at every layer)",
      "file_type": "rationale",
      "source_file": "docs/presentations/comlinked-stack-overview.pdf",
      "source_location": "p.2",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Security is built into the foundation, not added later; each layer enforces its own controls so one failure does not expose the system."
    },
    {
      "id": "docs_presentations_comlinked_stack_overview_role_based_access_control",
      "label": "Role-based access control (member, manager, admin, superadmin)",
      "file_type": "rationale",
      "source_file": "docs/presentations/comlinked-stack-overview.pdf",
      "source_location": "p.2",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Enforced on the server in route middleware and page code; fails closed, so if auth is unavailable access is denied."
    },
    {
      "id": "docs_presentations_comlinked_stack_overview_row_level_security",
      "label": "PostgreSQL Row-Level Security",
      "file_type": "rationale",
      "source_file": "docs/presentations/comlinked-stack-overview.pdf",
      "source_location": "p.2",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "RLS on every tenant table so each organization can only read and write its own data, enforced inside the database itself, not only in app code."
    },
    {
      "id": "docs_presentations_comlinked_stack_overview_pkce_sign_in_flow",
      "label": "PKCE sign-in flow and server-verified sessions",
      "file_type": "rationale",
      "source_file": "docs/presentations/comlinked-stack-overview.pdf",
      "source_location": "p.2",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Session verified with the auth server on every protected request; Secure, SameSite cookies; HTTPS-only in production."
    },
    {
      "id": "docs_presentations_comlinked_stack_overview_browser_hardening",
      "label": "Browser hardening (nonce CSP, HSTS, frame-deny)",
      "file_type": "rationale",
      "source_file": "docs/presentations/comlinked-stack-overview.pdf",
      "source_location": "p.2",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Strict Content-Security-Policy with a new nonce per request, HSTS (2-year, preload), clickjacking protection, nosniff, Referrer-Policy, Permissions-Policy, COOP/CORP; framework fingerprint header removed."
    },
    {
      "id": "docs_presentations_comlinked_stack_overview_owasp_top_10_mapping",
      "label": "OWASP Top 10 mapping",
