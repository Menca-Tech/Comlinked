    {
      "id": "docs_specs_2026_07_15_multi_tenancy_rls_isolation_boundary",
      "label": "RLS as the tenant isolation boundary",
      "file_type": "rationale",
      "source_file": "docs/specs/2026-07-15-multi-tenancy.md",
      "source_location": "L76",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Tenant isolation is enforced by Postgres RLS, not application code, so a forged or stale Active-Organization cookie cannot cross tenants. RLS must be tested against real Postgres because mocking the DB tests nothing about isolation."
